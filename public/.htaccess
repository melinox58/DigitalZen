# ----------------------------------------------------------------------
# Realignement & Réécriture SPA (React Router sur Apache/IONOS)
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# Configuration des en-têtes de sécurité HTTP
# ----------------------------------------------------------------------
<IfModule mod_headers.c>

  # 1. HSTS (Strict-Transport-Security) - Durée 1 an (31536000s) + subdomains + preload
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # 2. Content-Security-Policy (CSP stricte et adaptée au site)
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://lh3.googleusercontent.com https://contribution.usercontent.google.com; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com https://cdn.tailwindcss.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://calendar.google.com;"

  # 3. X-Frame-Options - Bloque l'intégration en iframe externe
  Header always set X-Frame-Options "SAMEORIGIN"

  # 4. X-Content-Type-Options - Empêche le MIME-sniffing
  Header always set X-Content-Type-Options "nosniff"

  # 5. Referrer-Policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # 6. Permissions-Policy - Désactive les API non utilisées
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), accelerometer=(), gyroscope=(), magnetometer=()"

  # 7. Cross-Origin-Opener-Policy (COOP)
  Header always set Cross-Origin-Opener-Policy "same-origin"

</IfModule>
